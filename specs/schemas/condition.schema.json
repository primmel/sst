{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primmel.org/sst/condition.schema.json",
  "title": "D 11 condition class declaration",
  "description": "One file per D 11 condition class under base/sst-oiml-base/conditions/.",
  "type": "object",
  "required": ["id", "title", "kind", "classification", "description", "severity_levels"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The condition class id; matches the manifest's condition_classes entry."
    },
    "title": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["steady", "cyclic", "transient"]
    },
    "classification": {
      "type": "string",
      "enum": ["influence", "disturbance"]
    },
    "iec_standard": {
      "type": "array",
      "items": { "type": "string" }
    },
    "d11_table": { "type": ["integer", "string"], "description": "The D 11 Ed 13 table number." },
    "d11_section": { "type": "string" },
    "applicability": {
      "type": "array",
      "items": { "type": "string", "enum": ["electronic", "non-electronic", "vehicle-powered"] },
      "minItems": 1
    },
    "description": { "type": "string", "minLength": 10 },
    "severity_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level"],
        "properties": {
          "level": { "type": ["integer", "string"] },
          "preferred": { "type": "boolean", "default": false }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
