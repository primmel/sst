{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primmel.org/sst/package-manifest.schema.json",
  "title": "SST package manifest",
  "description": "The package.sst.yaml manifest carried by every SST package (base, kind, instance).",
  "type": "object",
  "required": ["sst_version", "tier", "id", "title"],
  "discriminator": { "propertyName": "tier" },
  "properties": {
    "sst_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "The SST manifest version (semver major.minor)."
    },
    "tier": {
      "type": "string",
      "enum": ["oiml-base", "oiml-kind", "primmel-instance"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Globally unique across all loaded packages."
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "maps_to": {
      "type": "string",
      "description": "The standard or product this package maps to (e.g. oiml-d11-e13, oiml-r60, acme-lc500)."
    }
  },
  "oneOf": [
    {
      "title": "Base package",
      "properties": {
        "tier": { "const": "oiml-base" },
        "condition_classes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "description": "Grouped lists of condition class ids this base declares."
        }
      },
      "required": ["condition_classes"]
    },
    {
      "title": "Kind package",
      "properties": {
        "tier": { "const": "oiml-kind" },
        "base": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "active_domain": {
          "type": "string",
          "enum": ["mass", "speed", "dimensions", "gas-concentration", "flow", "volume", "force"]
        },
        "oiml_recommendation": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^oiml-r\\d+$" },
            "edition": { "type": "string" },
            "parts": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["id"]
        }
      },
      "required": ["base", "active_domain"]
    },
    {
      "title": "Instance package",
      "properties": {
        "tier": { "const": "primmel-instance" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string" },
        "manufacturer": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "country": { "type": "string", "minLength": 2, "maxLength": 2 },
            "contact": { "type": "string" }
          },
          "required": ["id", "name"]
        },
        "classification": {
          "type": "object",
          "additionalProperties": true
        },
        "design_parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": {},
              "unit": { "type": "string" }
            },
            "required": ["value"]
          }
        },
        "model": { "type": "string", "description": "Relative path to the glTF binary." },
        "coefficients": { "type": "string", "description": "Relative path to coefficients.yaml." },
        "behavior": { "type": "string", "description": "Relative path to behavior.js." },
        "samples": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "provenance": {
          "type": "object",
          "properties": {
            "certificate": { "type": "string" },
            "first_issued": { "type": "string", "format": "date" }
          }
        }
      },
      "required": ["kind", "manufacturer", "classification", "model", "coefficients", "behavior", "samples"]
    }
  ]
}
