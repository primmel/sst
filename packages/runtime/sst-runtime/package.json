{
  "name": "@primmel/sst-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Primmel SST runtime — kind-agnostic loader that composes a base + kind + instance package into a running sim.",
  "bin": {
    "primmel-sst": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./twin/driver": "./src/twin/driver.ts",
    "./twin/types": "./src/twin/types.ts",
    "./twin/transport": "./src/twin/transport.ts",
    "./twin/introspect": "./src/twin/introspect.ts",
    "./stages/composer": "./src/stages/composer.ts",
    "./stages/data-driven": "./src/stages/data-driven.ts",
    "./world/driver": "./src/world/driver.ts",
    "./world/types": "./src/world/types.ts",
    "./scene/context": "./src/scene/context.ts",
    "./scene/gltf": "./src/scene/gltf.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/bin.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@primmel/primmel": "file:../../../../../primmel/primmel-ts/packages/primmel",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
