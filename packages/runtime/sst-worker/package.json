{
  "name": "@primmel/sst-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Primmel SST Cloudflare Worker adapter — a simulation session in a Durable Object answering the same HTTP surface the node server answers (additive to the node entry, which keeps working unchanged).",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@primmel/sst-runtime": "file:../sst-runtime"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251008.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.42.0",
    "yaml": "^2.9.0"
  }
}
