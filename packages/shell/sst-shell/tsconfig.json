{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@runtime/*": ["../../runtime/sst-runtime/src/*"]
    },
    "jsx": "preserve",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  }
}
