---
// src/pages/kind/[id].astro — instances gallery for a kind.
// Static-generates one page per kind at build time.
import '../../styles/global.css'
import KindGallery from '../../components/KindGallery.vue'
import { buildCatalog } from '../../lib/catalog'

export async function getStaticPaths() {
  const { kinds } = await buildCatalog()
  return kinds.map(kind => ({ params: { id: kind.id }, props: { kind } }))
}

const { kind } = Astro.props
---
<!doctype html>
<html lang="en" style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{kind.title} — Primmel SST</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <KindGallery client:load kind={kind} />
  </body>
</html>
